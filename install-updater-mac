#!/usr/bin/env bash
#
# Install launchd agent to auto-update /usr/local/opt/scripts from git
# macOS equivalent of the systemd-based install-updater for Linux
#

set -euo pipefail

SCRIPTS_REPO="https://github.com/agoodkind/scripts.git"
SCRIPTS_DIR="/usr/local/opt/scripts"
AGENT_NAME="com.agoodkind.scripts-updater"
AGENT_PLIST="$HOME/Library/LaunchAgents/${AGENT_NAME}.plist"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() { echo -e "${GREEN}[+]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
error() { echo -e "${RED}[x]${NC} $1" >&2; exit 1; }

# Check for macOS
check_macos() {
    if [[ "$OSTYPE" != "darwin"* ]]; then
        error "This script is for macOS only. Use install-updater for Linux."
    fi
}

# Clone or update the scripts repo
setup_repo() {
    # Ensure /usr/local/opt exists
    if [[ ! -d "/usr/local/opt" ]]; then
        log "Creating /usr/local/opt..."
        sudo mkdir -p /usr/local/opt
        sudo chown "$USER" /usr/local/opt
    fi
    
    if [[ -d "$SCRIPTS_DIR/.git" ]]; then
        log "Scripts repo already exists, pulling latest..."
        git -C "$SCRIPTS_DIR" pull --ff-only || warn "Pull failed, continuing"
    else
        if [[ -d "$SCRIPTS_DIR" ]]; then
            warn "Removing existing $SCRIPTS_DIR (not a git repo)"
            rm -rf "$SCRIPTS_DIR"
        fi
        log "Cloning scripts repo to $SCRIPTS_DIR..."
        git clone "$SCRIPTS_REPO" "$SCRIPTS_DIR"
    fi
    chmod -R +x "$SCRIPTS_DIR"
}

# Create launchd agent plist
create_agent() {
    log "Creating launchd agent..."
    mkdir -p "$HOME/Library/LaunchAgents"
    
    cat > "$AGENT_PLIST" << EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${AGENT_NAME}</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/git</string>
        <string>-C</string>
        <string>${SCRIPTS_DIR}</string>
        <string>pull</string>
        <string>--ff-only</string>
    </array>
    
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>StandardOutPath</key>
    <string>/tmp/scripts-updater.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/scripts-updater.log</string>
</dict>
</plist>
EOF
}

# Load the agent
load_agent() {
    log "Loading launchd agent..."
    
    # Unload if already loaded
    launchctl bootout "gui/$(id -u)/${AGENT_NAME}" 2>/dev/null || true
    
    # Load the new agent
    launchctl bootstrap "gui/$(id -u)" "$AGENT_PLIST"
}

# Add to PATH via shell profile
setup_path() {
    local profile_file="/etc/paths.d/scripts"
    if [[ ! -f "$profile_file" ]]; then
        log "Adding $SCRIPTS_DIR to system PATH..."
        echo "$SCRIPTS_DIR" | sudo tee "$profile_file" > /dev/null
    else
        log "PATH already configured in $profile_file"
    fi
}

# Create symlinks in /usr/local/bin (alternative to paths.d)
create_symlinks() {
    log "Creating symlinks in /usr/local/bin..."
    
    # Ensure /usr/local/bin exists
    [[ -d "/usr/local/bin" ]] || sudo mkdir -p /usr/local/bin
    
    local script
    for script in "$SCRIPTS_DIR"/*; do
        [[ -f "$script" ]] || continue
        [[ -x "$script" ]] || continue
        
        local name
        name=$(basename "$script")
        
        # Skip non-script files
        case "$name" in
            LICENSE|README*|*.md|*.txt|.*) continue ;;
        esac
        
        local target="/usr/local/bin/$name"
        if [[ -L "$target" ]] && [[ "$(readlink "$target")" == "$script" ]]; then
            continue  # Already correct
        fi
        
        sudo ln -sf "$script" "$target"
        log "  Linked: $name"
    done
}

show_status() {
    echo ""
    log "Installation complete!"
    log "Scripts installed to: $SCRIPTS_DIR"
    log "LaunchAgent: $AGENT_PLIST"
    echo ""
    log "Useful commands:"
    echo "  Check status:  launchctl print gui/$(id -u)/${AGENT_NAME}"
    echo "  Run now:       launchctl kickstart gui/$(id -u)/${AGENT_NAME}"
    echo "  View log:      cat /tmp/scripts-updater.log"
    echo "  Unload:        launchctl bootout gui/$(id -u)/${AGENT_NAME}"
}

main() {
    log "Installing scripts-updater for macOS..."
    check_macos
    setup_repo
    create_agent
    load_agent
    setup_path
    create_symlinks
    show_status
}

main "$@"
