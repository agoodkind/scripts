#!/usr/bin/env bash
# Unified email sender: sendmail (default) or SMTP2GO HTTP API
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/email-formatting.sh"

HOSTNAME=$(hostname)
TO="" SUBJECT="" MSG="" FROM="" NAME="" CALLER=""
METHOD="sendmail"  # Default method
SMTP2GO_API_KEY=""
BIND_IFACE=""

die() { echo "Error: $1" >&2; exit 1; }
usage() {
    cat <<EOF
Usage: $0 -t TO -s SUBJ -m MSG [OPTIONS]

Required:
  -t TO         Recipient email address
  -s SUBJECT    Email subject
  -m MSG        Email message body

Optional:
  -f FROM       Sender email (default: ${HOSTNAME}-mailer@goodkind.io)
  -n NAME       Sender name (default: $HOSTNAME)
  -c CALLER     Caller name for metadata (auto-detected if not provided)
  --http        Use SMTP2GO HTTP API instead of sendmail
  -k API_KEY    SMTP2GO API key (required for --http)
  -i IFACE      Bind to specific network interface (HTTP mode only)
EOF
    exit 1
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -t) TO="$2"; shift 2 ;;
        -s) SUBJECT="$2"; shift 2 ;;
        -m) MSG="$2"; shift 2 ;;
        -f) FROM="$2"; shift 2 ;;
        -n) NAME="$2"; shift 2 ;;
        -c) CALLER="$2"; shift 2 ;;
        -k) SMTP2GO_API_KEY="$2"; shift 2 ;;
        -i) BIND_IFACE="$2"; shift 2 ;;
        --http) METHOD="http"; shift ;;
        -h|--help) usage ;;
        *)  usage ;;
    esac
done

[[ -z "$TO" || -z "$SUBJECT" || -z "$MSG" ]] && die "Missing required arguments"
[[ -z "$FROM" ]] && FROM="${HOSTNAME}-mailer@goodkind.io"
[[ -z "$NAME" ]] && NAME="$HOSTNAME"
[[ -z "$CALLER" ]] && CALLER=$(infer_caller)

# Send via HTTP API
send_http() {
    # Try to get API key from environment if not provided
    if [[ -z "$SMTP2GO_API_KEY" ]]; then
        for env_file in /etc/mwan-watchdog/watchdog.env /etc/mwan/mwan.env; do
            if [[ -r "$env_file" ]]; then
                # shellcheck disable=SC1090
                . "$env_file"
                SMTP2GO_API_KEY="${SMTP2GO_API_KEY:-}"
                [[ -n "$SMTP2GO_API_KEY" ]] && break
            fi
        done
    fi

    [[ -z "$SMTP2GO_API_KEY" ]] && die "SMTP2GO_API_KEY required for HTTP method"

    # Build curl command with optional interface binding
    local curl_cmd="curl -sS --max-time 30"
    if [[ -n "$BIND_IFACE" ]]; then
        curl_cmd="$curl_cmd --interface $BIND_IFACE"
    fi

    # Generate email bodies
    local text_body html_body
    text_body=$(render_plain "$MSG")
    text_body+=$'\n\nCaller: '"$CALLER"$'\nHost: '"$HOSTNAME"$'\nTime: '"$(date +'%Y-%m-%d %H:%M %Z')"
    html_body=$(render_html "$MSG" "$CALLER" "$HOSTNAME")

    # Build JSON payload using jq for proper escaping
    local payload
    payload=$(jq -n \
        --arg sender "$FROM" \
        --arg to "$TO" \
        --arg subject "$SUBJECT" \
        --arg text_body "$text_body" \
        --arg html_body "$html_body" \
        --arg header_name "X-Sender-Name" \
        --arg header_value "$NAME" \
        '{
            sender: $sender,
            to: [$to],
            subject: $subject,
            text_body: $text_body,
            html_body: $html_body,
            custom_headers: [
                {header: $header_name, value: $header_value}
            ]
        }')

    # Send via API
    local response
    response=$(${curl_cmd} \
        -X POST https://api.smtp2go.com/v3/email/send \
        -H "Content-Type: application/json" \
        -H "X-Smtp2go-Api-Key: $SMTP2GO_API_KEY" \
        -d "$payload") || die "HTTP request failed"

    # Check response
    if echo "$response" | jq -e '.data.succeeded > 0' >/dev/null 2>&1; then
        echo "Email sent to $TO via SMTP2GO HTTP API"
        return 0
    else
        local error_msg
        error_msg=$(echo "$response" | jq -r '.data.error // "Unknown error"' 2>/dev/null || echo "Unknown error")
        die "SMTP2GO API error: $error_msg"
    fi
}

# Send via sendmail
send_sendmail() {
    local from_header="\"$NAME\" <$FROM>"
    local boundary="----=_Part_$(date +%s)_$$"

    if command -v sendmail >/dev/null 2>&1; then
        {
            echo "From: $from_header"
            echo "To: $TO"
            echo "Subject: $SUBJECT"
            echo "MIME-Version: 1.0"
            echo "Content-Type: multipart/alternative; boundary=\"$boundary\""
            echo ""
            echo "--$boundary"
            echo "Content-Type: text/plain; charset=UTF-8"
            echo ""
            render_plain "$MSG"
            echo ""
            echo "--$boundary"
            echo "Content-Type: text/html; charset=UTF-8"
            echo ""
            render_html "$MSG" "$CALLER" "$HOSTNAME"
            echo ""
            echo "--$boundary--"
        } | sendmail -t -f "$FROM"
        echo "Email sent to $TO via sendmail"
    elif command -v mail >/dev/null 2>&1; then
        render_plain "$MSG" | mail -s "$SUBJECT" -a "From: $from_header" "$TO"
        echo "Email sent to $TO via mail"
    else
        die "No mail command found (sendmail or mail)"
    fi
}

# Main
if [[ "$METHOD" == "http" ]]; then
    send_http
else
    send_sendmail
fi
