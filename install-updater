#!/usr/bin/env bash
#
# Install systemd timer to auto-update /opt/scripts from git
# Only works on Debian/Ubuntu systems with systemd
#

set -euo pipefail

SCRIPTS_REPO="https://github.com/agoodkind/scripts.git"
SCRIPTS_DIR="/opt/scripts"
SERVICE_NAME="scripts-updater"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() { echo -e "${GREEN}[+]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
error() { echo -e "${RED}[x]${NC} $1" >&2; exit 1; }

# Check if running on systemd-based system
check_systemd() {
    if ! command -v systemctl &>/dev/null; then
        error "systemctl not found. This script requires systemd."
    fi
}

# Check for root/sudo
check_root() {
    if [[ $EUID -ne 0 ]]; then
        error "This script must be run as root or with sudo"
    fi
}

# Clone or update the scripts repo
setup_repo() {
    if [[ -d "$SCRIPTS_DIR/.git" ]]; then
        log "Scripts repo already exists, pulling latest..."
        git -C "$SCRIPTS_DIR" pull --ff-only || warn "Pull failed, continuing with existing version"
    else
        if [[ -d "$SCRIPTS_DIR" ]]; then
            warn "Removing existing $SCRIPTS_DIR (not a git repo)"
            rm -rf "$SCRIPTS_DIR"
        fi
        log "Cloning scripts repo to $SCRIPTS_DIR..."
        git clone "$SCRIPTS_REPO" "$SCRIPTS_DIR"
    fi
    chmod -R +x "$SCRIPTS_DIR"
}

# Create systemd service
create_service() {
    log "Creating systemd service..."
    cat > "/etc/systemd/system/${SERVICE_NAME}.service" << 'EOF'
[Unit]
Description=Update /opt/scripts from git
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/git -C /opt/scripts pull --ff-only
TimeoutStartSec=300
EOF
}

# Create systemd timer
create_timer() {
    log "Creating systemd timer..."
    cat > "/etc/systemd/system/${SERVICE_NAME}.timer" << 'EOF'
[Unit]
Description=Run scripts-updater daily

[Timer]
OnCalendar=daily
RandomizedDelaySec=3600
Persistent=true

[Install]
WantedBy=timers.target
EOF
}

# Enable and start the timer
enable_timer() {
    log "Enabling and starting timer..."
    systemctl daemon-reload
    systemctl enable "${SERVICE_NAME}.timer"
    systemctl start "${SERVICE_NAME}.timer"
}

# Add /opt/scripts to system PATH
setup_path() {
    local profile_file="/etc/profile.d/opt-scripts.sh"
    if [[ ! -f "$profile_file" ]]; then
        log "Adding /opt/scripts to system PATH..."
        echo 'export PATH="/opt/scripts:$PATH"' > "$profile_file"
        chmod 644 "$profile_file"
    else
        log "PATH already configured in $profile_file"
    fi
}

main() {
    log "Installing scripts-updater..."
    check_systemd
    check_root
    setup_repo
    create_service
    create_timer
    enable_timer
    setup_path
    
    log "Installation complete!"
    log "Scripts installed to: $SCRIPTS_DIR"
    log "Timer status: systemctl status ${SERVICE_NAME}.timer"
    log "Run manually: systemctl start ${SERVICE_NAME}.service"
    log "Log out and back in (or source /etc/profile.d/opt-scripts.sh) for PATH update"
}

main "$@"

