#!/usr/bin/env bash
#
# Pre-commit hook: ensure all scripts are executable and update VSCode settings
#

set -euo pipefail

# Run pre-commit framework first (gitleaks, etc.)
if command -v pre-commit &>/dev/null && [[ -f .pre-commit-config.yaml ]]; then
    pre-commit run --hook-stage pre-commit
fi

VSCODE_SETTINGS=".vscode/settings.json"

# Find script files (exclude metadata)
find_scripts() {
    local perm_filter="${1:-}"
    find . -maxdepth 1 -type f "$perm_filter" \
        ! -name ".*" \
        ! -name "LICENSE" \
        ! -name "README*" \
        ! -name "*.md" \
        ! -name "*.txt" \
        2>/dev/null || true
}

# Track if we made any changes
made_changes=false

# Ensure all scripts are executable
while IFS= read -r script; do
    [[ -z "$script" ]] && continue
    if [[ ! -x "$script" ]]; then
        echo "Setting executable bit on: $script"
        chmod +x "$script"
        git add "$script"
        made_changes=true
    fi
done < <(find_scripts)

# Update VSCode file associations for shell scripts
if [[ -f "$VSCODE_SETTINGS" ]]; then
    # Get list of executable scripts (basenames only)
    script_names=$(find_scripts "-perm +111" | xargs -n1 basename)

    # Build JSON object: {"script1": "shellscript", "script2": "shellscript", ...}
    associations=$(
        echo "$script_names" | \
        jq --raw-input --slurp '
            split("\n") |
            map(select(length > 0)) |
            map({(.): "shellscript"}) |
            add // {}
        '
    )

    # Update settings.json with new file associations
    if jq --argjson assoc "$associations" \
        '.["files.associations"] = $assoc' \
        "$VSCODE_SETTINGS" > "${VSCODE_SETTINGS}.tmp"
    then
        # Check if file actually changed
        if ! cmp -s "$VSCODE_SETTINGS" "${VSCODE_SETTINGS}.tmp"; then
            mv "${VSCODE_SETTINGS}.tmp" "$VSCODE_SETTINGS"
            git add "$VSCODE_SETTINGS"
            echo "✅ Updated VSCode file associations"
            made_changes=true
        else
            rm "${VSCODE_SETTINGS}.tmp"
        fi
    else
        rm -f "${VSCODE_SETTINGS}.tmp"
    fi
fi

if $made_changes; then
    echo "✅ Pre-commit fixes applied"
fi

exit 0
