#!/usr/bin/env bash
#
# Uninstall launchd agent and optionally remove scripts
#

set -euo pipefail

SCRIPTS_DIR="/usr/local/opt/scripts"
AGENT_NAME="com.agoodkind.scripts-updater"
AGENT_PLIST="$HOME/Library/LaunchAgents/${AGENT_NAME}.plist"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() { echo -e "${GREEN}[+]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }

remove_symlinks() {
    log "Removing symlinks from /usr/local/bin..."
    
    if [[ -d "$SCRIPTS_DIR" ]]; then
        local script
        for script in "$SCRIPTS_DIR"/*; do
            [[ -f "$script" ]] || continue
            local name
            name=$(basename "$script")
            local target="/usr/local/bin/$name"
            
            if [[ -L "$target" ]] && [[ "$(readlink "$target")" == "$script" ]]; then
                sudo rm "$target"
                log "  Removed: $name"
            fi
        done
    fi
}

unload_agent() {
    log "Unloading launchd agent..."
    launchctl bootout "gui/$(id -u)/${AGENT_NAME}" 2>/dev/null || true
    
    if [[ -f "$AGENT_PLIST" ]]; then
        rm "$AGENT_PLIST"
        log "Removed: $AGENT_PLIST"
    fi
}

remove_path() {
    local profile_file="/etc/paths.d/scripts"
    if [[ -f "$profile_file" ]]; then
        log "Removing PATH entry..."
        sudo rm "$profile_file"
    fi
}

remove_repo() {
    if [[ -d "$SCRIPTS_DIR" ]]; then
        log "Removing scripts repo..."
        rm -rf "$SCRIPTS_DIR"
    fi
}

main() {
    log "Uninstalling scripts-updater for macOS..."
    
    remove_symlinks
    unload_agent
    remove_path
    
    if [[ "${1:-}" == "--remove-scripts" ]]; then
        remove_repo
    else
        warn "Scripts repo kept at $SCRIPTS_DIR (use --remove-scripts to delete)"
    fi
    
    log "Uninstall complete!"
}

main "$@"
