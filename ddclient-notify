#!/usr/bin/env bash
# Notify on IP change via send-email
export PATH="/opt/scripts:$PATH"

HOSTNAME="$(hostname)"
DISPLAY_NAME="$HOSTNAME DDClient IP Change"
NEW_IP="$1"
TIMESTAMP=$(date "+%Y-%m-%d %H:%M:%S %Z")
STATE_DIR="/var/cache/ddclient-notify"
mkdir -p "$STATE_DIR"

# Determine if new IP is IPv4 or IPv6
if [[ "$NEW_IP" == *:* ]]; then
    IP_TYPE="ipv6"
else
    IP_TYPE="ipv4"
fi

# Read old IP from our own state file
STATE_FILE="$STATE_DIR/last-${IP_TYPE}"
OLD_IP=""
if [[ -f "$STATE_FILE" ]]; then
    OLD_IP=$(cat "$STATE_FILE")
fi

MSG="The public IP address for ${DISPLAY_NAME} has changed.\n\n"
MSG+="New IP: $NEW_IP\n"
[[ -n "$OLD_IP" && "$OLD_IP" != "$NEW_IP" ]] && MSG+="Old IP: $OLD_IP\n"
MSG+="Type: $IP_TYPE\n"
MSG+="Time: $TIMESTAMP"

/opt/scripts/send-email \
    -t alex@goodkind.io \
    -s "[ddclient] $HOSTNAME IP Address Changed ($IP_TYPE)" \
    -m "$MSG" \
    -n "$DISPLAY_NAME" \
    -c "ddclient"

# Save new IP as the old IP for next time
echo "$NEW_IP" > "$STATE_FILE"