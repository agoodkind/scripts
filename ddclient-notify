#!/usr/bin/env bash
# Notify on IP change via send-email.
# Old IP is read from our state file (and .bak fallback); first run has no old IP.
set -euo pipefail
export PATH="/opt/scripts:$PATH"

HOSTNAME="$(hostname)"
DISPLAY_NAME="$HOSTNAME DDClient IP Change"
NEW_IP="${1:-}"
TIMESTAMP=$(date "+%Y-%m-%d %H:%M:%S %Z")
STATE_DIR="${DDCLIENT_NOTIFY_STATE_DIR:-/var/cache/ddclient-notify}"
NOTIFY_EMAIL_TO="${DDCLIENT_NOTIFY_EMAIL_TO:-alex@goodkind.io}"
mkdir -p "$STATE_DIR"

# Determine if new IP is IPv4 or IPv6
if [[ "$NEW_IP" == *:* ]]; then
    IP_TYPE="ipv6"
else
    IP_TYPE="ipv4"
fi

# Read old IP from our state file; fall back to .bak if main is missing (e.g. after deploy)
STATE_FILE="$STATE_DIR/last-${IP_TYPE}"
OLD_IP=""
for f in "$STATE_FILE" "${STATE_FILE}.bak"; do
    if [[ -f "$f" && -r "$f" ]]; then
        read -r OLD_IP < "$f" || true
        OLD_IP="${OLD_IP%"${OLD_IP##*[![:space:]]}"}"
        OLD_IP="${OLD_IP#"${OLD_IP%%[![:space:]]*}"}"
        [[ -n "$OLD_IP" ]] && break
    fi
done

# Include Old IP in body only when we have a value and it differs from new
MSG="The public IP address for ${DISPLAY_NAME} has changed.\n\n"
MSG+="New IP: $NEW_IP\n"
[[ -n "$OLD_IP" && "$OLD_IP" != "$NEW_IP" ]] && MSG+="Old IP: $OLD_IP\n"
MSG+="Type: $IP_TYPE\n"
MSG+="Time: $TIMESTAMP"

"${DDCLIENT_NOTIFY_SEND_EMAIL:-/opt/scripts/send-email}" \
    -t "$NOTIFY_EMAIL_TO" \
    -s "[ddclient] $HOSTNAME IP Address Changed ($IP_TYPE)" \
    -m "$MSG" \
    -n "$DISPLAY_NAME" \
    -c "ddclient"

# Persist new IP for next run; keep backup of previous so fallback has a value if state is lost
if [[ -n "$NEW_IP" ]]; then
    echo "$NEW_IP" > "$STATE_FILE" || true
    [[ -n "$OLD_IP" ]] && echo "$OLD_IP" > "${STATE_FILE}.bak" || true
fi
