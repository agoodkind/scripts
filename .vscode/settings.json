{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/CVS": true,
        "**/.ruby-lsp": true,
        "**/.retool_types/**": true,
        "**/*tsconfig.json": true,
        ".cache": true,
        "retool.config.json": true
    },
    "files.associations": {
        "*install-updater*": "shellscript",
        "*uninstall-updater*": "shellscript",
        "backup-*": "shellscript",
        "bootstrap-*": "shellscript",
        "change-*": "shellscript",
        "check-*": "shellscript",
        "prep-*": "shellscript",
        "reapply-*": "shellscript",
        "send-*": "shellscript",
        "wan-*": "shellscript",
        "*-sync": "shellscript",
        "*-notify": "shellscript",
        "*-cmd": "shellscript",
        "screenshot": "shellscript"
    }
}