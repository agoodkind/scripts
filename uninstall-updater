#!/usr/bin/env bash
#
# Uninstall systemd timer for /opt/scripts auto-updates
# Optionally removes /opt/scripts directory
#

set -euo pipefail

SERVICE_NAME="scripts-updater"
SCRIPTS_DIR="/opt/scripts"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() { echo -e "${GREEN}[+]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
error() { echo -e "${RED}[x]${NC} $1" >&2; exit 1; }

# Check for root/sudo
check_root() {
    if [[ $EUID -ne 0 ]]; then
        error "This script must be run as root or with sudo"
    fi
}

# Stop and disable the timer
disable_timer() {
    if systemctl is-active "${SERVICE_NAME}.timer" &>/dev/null; then
        log "Stopping timer..."
        systemctl stop "${SERVICE_NAME}.timer"
    fi
    
    if systemctl is-enabled "${SERVICE_NAME}.timer" &>/dev/null; then
        log "Disabling timer..."
        systemctl disable "${SERVICE_NAME}.timer"
    fi
}

# Remove systemd files
remove_systemd_files() {
    local service_file="/etc/systemd/system/${SERVICE_NAME}.service"
    local timer_file="/etc/systemd/system/${SERVICE_NAME}.timer"
    
    if [[ -f "$service_file" ]]; then
        log "Removing service file..."
        rm -f "$service_file"
    fi
    
    if [[ -f "$timer_file" ]]; then
        log "Removing timer file..."
        rm -f "$timer_file"
    fi
    
    systemctl daemon-reload
}

# Remove PATH configuration
remove_path() {
    local profile_file="/etc/profile.d/opt-scripts.sh"
    if [[ -f "$profile_file" ]]; then
        log "Removing PATH configuration..."
        rm -f "$profile_file"
    fi
}

# Optionally remove scripts directory
remove_scripts() {
    if [[ -d "$SCRIPTS_DIR" ]]; then
        if [[ "${1:-}" == "--purge" ]]; then
            log "Removing $SCRIPTS_DIR..."
            rm -rf "$SCRIPTS_DIR"
        else
            warn "Keeping $SCRIPTS_DIR (use --purge to remove)"
        fi
    fi
}

main() {
    local purge="${1:-}"
    
    log "Uninstalling scripts-updater..."
    check_root
    disable_timer
    remove_systemd_files
    remove_path
    remove_scripts "$purge"
    
    log "Uninstallation complete!"
    [[ "$purge" != "--purge" ]] && log "Scripts still available at: $SCRIPTS_DIR"
}

main "$@"

